{
  "name": "dsh-plugin-local-voice",
  "version": "1.5.1",
  "private": false,
  "description": "Local real-time speech-to-text for DeepSeek Harness: a floating transcription panel plus a Qwen3-ASR recognizer provider (Apple Silicon). Fully offline.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "speech-to-text",
    "asr",
    "qwen3",
    "mlx",
    "offline",
    "voice"
  ],
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "qwen3_worker.py",
    "cordis.patch.yml",
    "scripts/",
    "docs/",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./scripts/prepare_model.py": "./scripts/prepare_model.py",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
